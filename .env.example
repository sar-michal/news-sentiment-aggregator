# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and replace the placeholder values below.
# ==============================================================================

# --- Database ---
DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_PORT=5432
DB_SSLMODE=disable

# --- Elasticsearch & Kibana ---
ES_PORT=9200
KIBANA_PORT=5601
# Limit memory (adjust based on your system limits)
ES_JAVA_OPTS=-Xms2g -Xmx2g

# Local Hardware Overrides
CELERY_CONCURRENCY=6

# --- Project Settings ---
DOCKER_DB_HOST=db
DOCKER_ES_HOST=elasticsearch
DOCKER_REDIS_HOST=redis